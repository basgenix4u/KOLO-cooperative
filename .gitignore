# --- Secrets and environment ---------------------------------------------
# Never commit credentials. .env holds dev-only values, but it is still a file
# that will one day hold something real, so it stays out of history entirely.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
key.properties
serviceAccountKey.json
google-services.json
GoogleService-Info.plist

